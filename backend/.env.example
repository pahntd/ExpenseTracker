# Expense Tracker backend - production environment contract.
# The same variables apply to the temporary Render Free verification environment and to a later
# permanent production environment.
# TEMPLATE ONLY: never put real values in this file or commit a filled-in copy (.env is gitignored).
# Real values are set in the hosting provider's environment settings (Render), not in a file.
# See backend/DEPLOYMENT.md for how each value is obtained.

# Selects fail-fast configuration: all three DATABASE_* variables become mandatory.
# (The Docker image already defaults to production; set it explicitly anyway.)
APP_ENV=production

# JDBC format is required - NOT the postgresql://user:pass@host/db URL Render displays.
# Use the Render Postgres INTERNAL hostname (same region, private network):
#   jdbc:postgresql://<RENDER_DB_INTERNAL_HOST>:5432/<RENDER_DB_NAME>
DATABASE_URL=

# Render-generated database user (owner of the database, has the DDL rights Flyway needs).
DATABASE_USER=

# Render-generated database password: <PRODUCTION_DB_PASSWORD>
DATABASE_PASSWORD=

# Production-only HMAC secret, generated separately from any development value: <PRODUCTION_JWT_SECRET>
# Rotating it logs every user out (access tokens become invalid; refresh tokens keep working).
JWT_SECRET=

# Redis-compatible store for the shared IP rate-limit counters (login/register/refresh).
# Use the Render Key Value INTERNAL URL (same region, private network): redis://<RENDER_KV_INTERNAL_HOST>:6379
# Mandatory in production; startup fails if it is missing or Redis does not answer PING.
REDIS_URL=

# The one request header that holds the real client IP. Render's edge (Cloudflare) overwrites
# CF-Connecting-IP; X-Forwarded-For is NOT trustworthy there (its first entry is client-supplied).
# Leave unset on any server reachable without that proxy (e.g. local docker-compose).
CLIENT_IP_HEADER=CF-Connecting-IP

# Container port. Render routes to the value of PORT; keep it at 8080 to match the Dockerfile's EXPOSE.
PORT=8080

# Optional: let the JVM use more of the 512 MB Render Free instance than its 25% default heap.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
