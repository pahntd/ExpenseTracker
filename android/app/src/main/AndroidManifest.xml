<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Backup policy: no app data is backed up, restored or device-transferred. Synced data is
         recovered from the backend after login; unsynced PENDING_* rows may be lost (accepted).
         allowBackup=false turns off cloud/adb backup; on Android 12+ it does not stop
         device-to-device transfer, so data_extraction_rules excludes everything for both paths
         and backup_rules does the same for API 29-30. -->
    <application
        android:name=".ExpenseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_app"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/logo_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AdMob app ID, injected per build type from app/build.gradle.kts (debug = Google test
             ID, release = real ID). The Next-Gen SDK and UMP also receive it in code via AdsConfig. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- WorkManager is initialized manually via ExpenseApplication (Configuration.Provider)
             so it picks up the HiltWorkerFactory; the default androidx-startup initializer must
             be removed to avoid double-initialization. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>