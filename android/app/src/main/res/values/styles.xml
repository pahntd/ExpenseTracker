<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomNavigationActiveIndicator">
        <item name="android:color">@color/bottom_bar_icon_active_indicator_color</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">
            @style/BottomNavigationActiveIndicatorShape
        </item>
    </style>

    <style name="BottomNavigationActiveIndicatorShape">
        <item name="cornerSize">50%</item>
    </style>

    <!-- "[ad icon] Watch an ad to unlock for 3 hours" line shown on a locked Statistics card. -->
    <style name="RewardedUnlockMessage">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawableStart">@drawable/ic_rewarded_ad</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:text">Watch an ad to unlock for 3 hours</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Rewarded unlock CTA, styled like the Login button (bg_button_ripple, bold black text). -->
    <style name="RewardedUnlockButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginHorizontal">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:background">@drawable/bg_button_ripple</item>
        <item name="backgroundTint">@null</item>
        <item name="android:text">Watch ad to unlock</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
