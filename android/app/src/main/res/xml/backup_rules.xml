<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 (API 30) and lower. Android 12+ uses data_extraction_rules.xml.
   Policy: back up no app data (Room database, session DataStore, Tink keyset, preferences).
   android:allowBackup="false" already disables backup; these exclusions keep the rules consistent
   with that policy. See https://developer.android.com/identity/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
