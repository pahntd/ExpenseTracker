<?xml version="1.0" encoding="utf-8"?>
<!-- Production/default: HTTPS only, no cleartext exceptions. The debug build type overrides this
     file with src/debug/res/xml/network_security_config.xml to reach the local LAN backend. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
